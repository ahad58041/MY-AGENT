# Copy to backend/.env and fill in. NEVER commit the real .env.

# PostgreSQL connection. Your Postgres 18 runs on port 5433 with trust auth
# (password not checked for localhost), so any password works locally.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/reelpilot

# Gemini API key for AI caption generation. FREE key: https://aistudio.google.com
GOOGLE_API_KEY=

# Caption model. gemini-3.1-flash-lite = fast + reliable on the free tier.
# Bump to gemini-3.5-flash / gemini-3.1-pro-preview for higher quality.
GEMINI_MODEL=gemini-3.1-flash-lite

# Postiz self-hosted instance (Phase 3). Web UI + API on 4007.
# Paste a Public API key after connecting accounts (Settings > Developers).
POSTIZ_API_URL=http://localhost:4007
POSTIZ_API_KEY=

# Auto video subtitles (faster-whisper). base.en = fast; small.en = more accurate.
WHISPER_MODEL=base.en
SUBTITLE_LANGUAGE=en

# Where uploaded videos are stored (relative to backend/)
STORAGE_DIR=storage

# Max upload size in megabytes
MAX_UPLOAD_MB=200
